<UserControl x:Class="ZenBox.Controls.ErrorDialogOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid Background="{StaticResource ModalBackdropBrush}">
        <Border MaxWidth="860"
                Margin="48"
                Padding="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource GlassPanelStrongBrush}"
                BorderBrush="{StaticResource WarningCoralBrush}"
                BorderThickness="2"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.4" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <!-- Phần 1: Tiêu đề + Giải thích bình dân -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="32"
                            Background="{StaticResource WarningCoralSoftBrush}"
                            BorderBrush="{StaticResource WarningCoralBrush}"
                            BorderThickness="2"
                            Margin="0,0,20,0">
                        <TextBlock Text="!"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningCoralBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding ActiveError.Title}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               MaxWidth="680" />
                </StackPanel>

                <TextBlock Text="{Binding ActiveError.Explanation}"
                           FontSize="22"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="32"
                           Margin="0,0,0,28" />

                <!-- Phần 2: 1-2 bước tự khắc phục đơn giản -->
                <Border Background="{StaticResource GlassSurfaceBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="26,22"
                        Margin="0,0,0,34">
                    <StackPanel>
                        <TextBlock Text="Cách khắc phục nhanh:"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding ActiveError.RecoverySteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="20"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="30"
                                               Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Phần 3: Các nút hành động to rõ -->
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="Thử lại ngay"
                            Style="{StaticResource PrimaryCyanButtonStyle}"
                            Command="{Binding RetryErrorActionCommand}"
                            Visibility="{Binding ActiveError.CanRetry, Converter={StaticResource BoolToVis}}"
                            MinHeight="64"
                            MinWidth="220"
                            FontSize="22"
                            Margin="0,0,24,12" />

                    <Button Content="Về Trang Chủ"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding DismissErrorToHomeCommand}"
                            MinHeight="64"
                            MinWidth="220"
                            FontSize="22"
                            Margin="0,0,24,12" />

                    <Button Content="Mở Phim Offline"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding DismissErrorToOfflineMoviesCommand}"
                            MinHeight="64"
                            MinWidth="230"
                            FontSize="22"
                            Margin="0,0,0,12" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
