<UserControl x:Class="ZenBox.Controls.ErrorDialogOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid Background="{StaticResource ModalBackdropBrush}">
        <Border Width="820"
                Margin="48"
                Padding="44,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F50D1424"
                BorderBrush="#66FB7185"
                BorderThickness="1.5"
                CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.6" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <!-- Phần 1: Tiêu đề + Giải thích bình dân -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                    <Border Width="60"
                            Height="60"
                            CornerRadius="20"
                            Background="{StaticResource WarningCoralSoftBrush}"
                            BorderBrush="{StaticResource WarningCoralBrush}"
                            BorderThickness="1.5"
                            Margin="0,0,20,0">
                        <TextBlock Text="!"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningCoralBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding ActiveError.Title}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               MaxWidth="640" />
                </StackPanel>

                <TextBlock Text="{Binding ActiveError.Explanation}"
                           FontSize="21"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="32"
                           Margin="0,0,0,26" />

                <!-- Phần 2: 1-2 bước tự khắc phục đơn giản -->
                <Border Background="#18FFFFFF"
                        BorderBrush="#2EFFFFFF"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="26,22"
                        Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="Cách khắc phục nhanh:"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding ActiveError.RecoverySteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="19"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="30"
                                               Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Phần 3: Các nút hành động đối xứng rõ ràng -->
                <WrapPanel HorizontalAlignment="Center">
                    <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                            Command="{Binding RetryErrorActionCommand}"
                            Visibility="{Binding ActiveError.CanRetry, Converter={StaticResource BoolToVis}}"
                            MinHeight="62"
                            MinWidth="220"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefreshGeometry}"
                                  Fill="#FFFFFF"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Thử lại ngay" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding DismissErrorToHomeCommand}"
                            MinHeight="62"
                            MinWidth="220"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHomeGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Về Trang Chủ" FontSize="20" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding DismissErrorToOfflineMoviesCommand}"
                            MinHeight="62"
                            MinWidth="230">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconMovieGeometry}"
                                  Fill="#FBBF24"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Mở Phim Offline" FontSize="20" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
