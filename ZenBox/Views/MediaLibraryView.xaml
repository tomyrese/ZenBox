<UserControl x:Class="ZenBox.Views.MediaLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề kho Phim / Nhạc -->
        <Grid Grid.Row="0" Margin="56,28,56,12" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="{Binding HeaderTitle}"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding CurrentFolderDisplay}"
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="False">
                <Button Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding RefreshLibraryCommand}"
                        MinHeight="58"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefreshGeometry}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Quét lại danh sách" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding OpenConfigCommand}"
                        MinHeight="58"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFolderGeometry}"
                              Fill="{StaticResource AccentCyanBrush}"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Chọn thư mục khác" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                        Command="{Binding GoHomeCommand}"
                        MinHeight="58">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconHomeGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Về Trang Chủ" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Trạng thái đang quét -->
        <Border Grid.Row="1"
                Style="{StaticResource GlassPanelBorderStyle}"
                Padding="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Đang quét tìm phim và bài hát trong máy, vui lòng đợi giây lát..."
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentCyanBrush}" />
        </Border>

        <!-- Trạng thái thư mục trống -->
        <Border Grid.Row="1"
                Style="{StaticResource GlassPanelBorderStyle}"
                MaxWidth="760"
                Padding="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Ellipse Fill="{StaticResource CyanAmbientBloomBrush}" Margin="-12" />
                    <Border CornerRadius="24" Background="{StaticResource AccentCyanSoftBrush}" BorderBrush="#5538BDF8" BorderThickness="1.5" />
                    <Path Data="{StaticResource IconFolderGeometry}"
                          Fill="{StaticResource AccentCyanBrush}"
                          Stretch="Uniform"
                          Width="36"
                          Height="36"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding EmptyStateMessage}"
                           FontSize="22"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="34"
                           Margin="0,0,0,28" />
                <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                        Command="{Binding OpenConfigCommand}"
                        HorizontalAlignment="Center"
                        MinHeight="62"
                        Padding="34,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolderGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="22"
                              Height="22"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Mở Cài đặt để chọn thư mục" FontSize="21" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Lưới Poster Phim & Nhạc: Khoảng đệm Margin nằm BÊN TRONG ScrollViewer để thẻ đầu tiên khi phóng to 1.045x + nhấc lên 6px KHÔNG BAO GIỜ BỊ CẮT CẠNH -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding MediaItems}"
                          Margin="56,20,40,36"
                          ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlassTileButtonStyle}"
                                Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Width="340"
                                Height="312"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border CornerRadius="20"
                                            ClipToBounds="True"
                                            Background="#1EFFFFFF"
                                            BorderBrush="#2EFFFFFF"
                                            BorderThickness="1">
                                        <Image Source="{Binding CoverImage}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Nút Play Liquid Glass nổi góc dưới bên phải Poster -->
                                    <Grid Width="50"
                                          Height="50"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="12">
                                        <Border CornerRadius="25"
                                                Background="#CC0B1120"
                                                BorderBrush="#88FFFFFF"
                                                BorderThickness="1.4" />
                                        <Border CornerRadius="25"
                                                Background="{StaticResource LiquidTopSheenBrush}" />
                                        <Path Data="{StaticResource IconPlayGeometry}"
                                              Fill="#FFFFFF"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              Margin="3,0,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SubInfoText}"
                                               FontSize="18"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
