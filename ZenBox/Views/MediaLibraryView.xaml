<UserControl x:Class="ZenBox.Views.MediaLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid Margin="56,30,56,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề kho Phim / Nhạc căn lề thẳng tắp -->
        <Grid Grid.Row="0" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="{Binding HeaderTitle}"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding CurrentFolderDisplay}"
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding RefreshLibraryCommand}"
                        MinHeight="58"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefreshGeometry}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Quét lại danh sách" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding OpenConfigCommand}"
                        MinHeight="58"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFolderGeometry}"
                              Fill="{StaticResource AccentCyanBrush}"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Chọn thư mục khác" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                        Command="{Binding GoHomeCommand}"
                        MinHeight="58">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconHomeGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Về Trang Chủ" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Trạng thái đang quét -->
        <Border Grid.Row="1"
                Style="{StaticResource GlassPanelBorderStyle}"
                Padding="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Đang quét tìm phim và bài hát trong máy, vui lòng đợi giây lát..."
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentCyanBrush}" />
        </Border>

        <!-- Trạng thái thư mục trống -->
        <Border Grid.Row="1"
                Style="{StaticResource GlassPanelBorderStyle}"
                MaxWidth="760"
                Padding="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="76"
                        Height="76"
                        CornerRadius="22"
                        Background="{StaticResource AccentCyanSoftBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,22">
                    <Path Data="{StaticResource IconFolderGeometry}"
                          Fill="{StaticResource AccentCyanBrush}"
                          Stretch="Uniform"
                          Width="36"
                          Height="36"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding EmptyStateMessage}"
                           FontSize="22"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="34"
                           Margin="0,0,0,28" />
                <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                        Command="{Binding OpenConfigCommand}"
                        HorizontalAlignment="Center"
                        MinHeight="62"
                        Padding="32,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolderGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="22"
                              Height="22"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Mở Cài đặt để chọn thư mục" FontSize="21" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Lưới Poster Phim & Nhạc cỡ lớn -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding MediaItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlassTileButtonStyle}"
                                Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Width="336"
                                Height="306"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="186" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border CornerRadius="16"
                                            ClipToBounds="True"
                                            Background="#1AFFFFFF">
                                        <Image Source="{Binding CoverImage}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>
                                    <Border Width="48"
                                            Height="48"
                                            CornerRadius="24"
                                            Background="#AA0B0F19"
                                            BorderBrush="#66FFFFFF"
                                            BorderThickness="1.5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="12">
                                        <Path Data="{StaticResource IconPlayGeometry}"
                                              Fill="#FFFFFF"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              Margin="3,0,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SubInfoText}"
                                               FontSize="18"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
