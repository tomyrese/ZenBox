<UserControl x:Class="ZenBox.Views.MediaLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề + Tìm kiếm tức thì + Nút thao tác (chừa vùng an toàn bên phải không vướng nút nổi) -->
        <Grid Grid.Row="0" Margin="52,26,112,14" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,16,0" />
                    <Border Background="#2038BDF8"
                            BorderBrush="#4438BDF8"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ItemCountText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding CurrentFolderDisplay}"
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="520"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Ô tìm kiếm nhanh phim / bài hát -->
            <Border Grid.Column="1"
                    MaxWidth="420"
                    Height="54"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#16FFFFFF"
                    BorderBrush="{StaticResource LiquidGlassRimBrush}"
                    BorderThickness="1.2"
                    CornerRadius="27"
                    Padding="20,0"
                    Margin="0,0,18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="{StaticResource IconSearchGeometry}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Stretch="Uniform"
                          Width="20"
                          Height="20"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="Tìm nhanh tên phim / bài hát..."
                                   FontSize="18"
                                   Foreground="#7794A3B8"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchKeyword}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentCyanBrush}"
                                 FontSize="18"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="False">
                <Button Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding RefreshLibraryCommand}"
                        MinHeight="54"
                        Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefreshGeometry}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Quét lại" FontSize="18" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding OpenConfigCommand}"
                        MinHeight="54"
                        Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFolderGeometry}"
                              Fill="{StaticResource AccentCyanBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Đổi thư mục" FontSize="18" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                        Command="{Binding GoHomeCommand}"
                        MinHeight="54">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconHomeGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Trang Chủ" FontSize="18" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Đang quét -->
        <Border Grid.Row="1"
                Style="{StaticResource GlassPanelBorderStyle}"
                Padding="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Đang quét tìm phim và bài hát trong máy, vui lòng đợi giây lát..."
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentCyanBrush}" />
        </Border>

        <!-- Thư mục trống -->
        <Border Grid.Row="1"
                Style="{StaticResource GlassPanelBorderStyle}"
                MaxWidth="740"
                Padding="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <Path Data="{StaticResource IconFolderGeometry}"
                      Fill="{StaticResource AccentCyanBrush}"
                      Stretch="Uniform"
                      Width="52"
                      Height="52"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20" />
                <TextBlock Text="{Binding EmptyStateMessage}"
                           FontSize="22"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="34"
                           Margin="0,0,0,28" />
                <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                        Command="{Binding OpenConfigCommand}"
                        HorizontalAlignment="Center"
                        MinHeight="60"
                        Padding="32,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolderGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Mở Cài đặt để chọn thư mục" FontSize="20" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Lưới Poster Phim & Nhạc -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding MediaItems}"
                          Margin="52,20,104,36"
                          ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlassTileButtonStyle}"
                                Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Width="336"
                                Height="308"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="188" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border CornerRadius="20"
                                            ClipToBounds="True"
                                            Background="#18FFFFFF"
                                            BorderBrush="#2AFFFFFF"
                                            BorderThickness="1">
                                        <Image Source="{Binding CoverImage}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>

                                    <Grid Width="48"
                                          Height="48"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="12">
                                        <Border CornerRadius="24"
                                                Background="#CC080D1A"
                                                BorderBrush="#88FFFFFF"
                                                BorderThickness="1.4" />
                                        <Path Data="{StaticResource IconPlayGeometry}"
                                              Fill="#FFFFFF"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              Margin="3,0,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,5" />
                                    <TextBlock Text="{Binding SubInfoText}"
                                               FontSize="18"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
