<UserControl x:Class="ZenBox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="48,28,48,28">
        <StackPanel MaxWidth="1060" HorizontalAlignment="Left">
            <!-- Tiêu đề màn hình -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cài đặt hệ thống"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Chọn nơi lưu trữ phim nhạc trong máy và thiết lập tự động mở khi bật máy tính"
                               FontSize="20"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="⌂ Về Trang Chủ"
                        Style="{StaticResource PrimaryCyanButtonStyle}"
                        Command="{Binding GoHomeCommand}"
                        MinHeight="60"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Thông báo xác nhận đã lưu -->
            <Border Background="{StaticResource SuccessGreenSoftBrush}"
                    BorderBrush="{StaticResource SuccessGreenBrush}"
                    BorderThickness="2"
                    CornerRadius="20"
                    Padding="24,16"
                    Margin="0,0,0,24"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SuccessGreenBrush}" />
            </Border>

            <!-- Mục 1: Thư mục Phim -->
            <Border Style="{StaticResource GlassPanelBorderStyle}" Padding="32" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="🎬 Thư mục chứa Phim của tôi"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{Binding MoviesFolderPath}"
                                   FontSize="20"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Chọn thư mục Phim..."
                            Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding ChooseMoviesFolderCommand}"
                            MinHeight="62"
                            MinWidth="260"
                            FontSize="22"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Mục 2: Thư mục Nhạc -->
            <Border Style="{StaticResource GlassPanelBorderStyle}" Padding="32" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="🎵 Thư mục chứa Nhạc của tôi"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{Binding MusicFolderPath}"
                                   FontSize="20"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Chọn thư mục Nhạc..."
                            Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding ChooseMusicFolderCommand}"
                            MinHeight="62"
                            MinWidth="260"
                            FontSize="22"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Mục 3: Tự khởi động cùng Windows 11 -->
            <Border Style="{StaticResource GlassPanelBorderStyle}" Padding="32">
                <StackPanel>
                    <TextBlock Text="🚀 Mở tự động cùng máy tính"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />
                    <CheckBox Style="{StaticResource LargeSwitchCheckBoxStyle}"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Content="Tự khởi động cùng Windows 11 ngay khi bật nguồn máy tính" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
