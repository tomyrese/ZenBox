<UserControl x:Class="ZenBox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1160"
                    HorizontalAlignment="Left"
                    Margin="56,30,56,36"
                    ClipToBounds="False">
            <!-- Tiêu đề màn hình -->
            <Grid Margin="0,0,0,28" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Cài đặt hệ thống"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Chọn nơi lưu trữ phim nhạc trong máy và thiết lập tự động mở cùng Windows 11"
                               FontSize="19"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryCyanButtonStyle}"
                        Command="{Binding GoHomeCommand}"
                        MinHeight="58"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconHomeGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Về Trang Chủ" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Thông báo xác nhận -->
            <Border Background="{StaticResource SuccessGreenSoftBrush}"
                    BorderBrush="#6634D399"
                    BorderThickness="1.5"
                    CornerRadius="22"
                    Padding="24,16"
                    Margin="0,0,0,24"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SuccessGreenBrush}" />
            </Border>

            <!-- Mục 1: Thư mục Phim -->
            <Grid Margin="0,0,0,22" ClipToBounds="False">
                <Border Style="{StaticResource GlassPanelBorderStyle}" />
                <Border Background="{StaticResource LiquidTopSheenBrush}" CornerRadius="28" Margin="1.5" IsHitTestVisible="False" />
                <Grid Margin="32,28" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="62" Height="62" Margin="0,0,22,0" VerticalAlignment="Center">
                        <Border CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0" />
                                    <GradientStop Color="#EA580C" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="18" Background="{StaticResource LiquidTopSheenBrush}" />
                        <Border CornerRadius="18" BorderBrush="#66FFFFFF" BorderThickness="1.2" />
                        <Path Data="{StaticResource IconMovieGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Thư mục chứa Phim của tôi"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding MoviesFolderPath}"
                                   FontSize="19"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding ChooseMoviesFolderCommand}"
                            MinHeight="58"
                            MinWidth="250"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolderGeometry}"
                                  Fill="{StaticResource AccentCyanBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Chọn thư mục Phim" FontSize="19" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- Mục 2: Thư mục Nhạc -->
            <Grid Margin="0,0,0,22" ClipToBounds="False">
                <Border Style="{StaticResource GlassPanelBorderStyle}" />
                <Border Background="{StaticResource LiquidTopSheenBrush}" CornerRadius="28" Margin="1.5" IsHitTestVisible="False" />
                <Grid Margin="32,28" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="62" Height="62" Margin="0,0,22,0" VerticalAlignment="Center">
                        <Border CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#A855F7" Offset="0" />
                                    <GradientStop Color="#EC4899" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="18" Background="{StaticResource LiquidTopSheenBrush}" />
                        <Border CornerRadius="18" BorderBrush="#66FFFFFF" BorderThickness="1.2" />
                        <Path Data="{StaticResource IconMusicGeometry}"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Thư mục chứa Nhạc của tôi"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding MusicFolderPath}"
                                   FontSize="19"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding ChooseMusicFolderCommand}"
                            MinHeight="58"
                            MinWidth="250"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolderGeometry}"
                                  Fill="{StaticResource AccentCyanBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Chọn thư mục Nhạc" FontSize="19" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- Mục 3: Khởi động cùng Windows 11 -->
            <Grid ClipToBounds="False">
                <Border Style="{StaticResource GlassPanelBorderStyle}" />
                <Border Background="{StaticResource LiquidTopSheenBrush}" CornerRadius="28" Margin="1.5" IsHitTestVisible="False" />
                <StackPanel Margin="32,28">
                    <TextBlock Text="Khởi động tự động cùng máy tính"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />
                    <CheckBox Style="{StaticResource LargeSwitchCheckBoxStyle}"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Content="Tự khởi động cùng Windows 11 ngay khi bật nguồn máy tính" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
