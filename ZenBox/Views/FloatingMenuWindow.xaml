<Window x:Class="ZenBox.Views.FloatingMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trung tâm điều khiển nổi ZenBox"
        Width="96"
        Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid ClipToBounds="False">
        <!-- Trạng thái 1: Viên ngọc Liquid Glass Orb 64x64px có hiệu ứng phóng mượt khi rê chuột -->
        <Grid x:Name="AssistiveBallContainer"
              Width="96"
              Height="96"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ClipToBounds="False">
            <Grid x:Name="AssistiveBall"
                  Width="64"
                  Height="64"
                  Cursor="Hand"
                  RenderTransformOrigin="0.5,0.5"
                  ToolTip="Bấm mở Trung tâm điều khiển hoặc giữ chuột để kéo đi"
                  PreviewMouseLeftButtonDown="OnBallMouseLeftButtonDown"
                  PreviewMouseMove="OnBallMouseMove"
                  PreviewMouseLeftButtonUp="OnBallMouseLeftButtonUp">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Ellipse Margin="-12" Fill="{StaticResource CyanAmbientBloomBrush}" IsHitTestVisible="False" />
                <Border CornerRadius="32">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E81E293B" Offset="0.0" />
                            <GradientStop Color="#EE0B1324" Offset="0.65" />
                            <GradientStop Color="#DD0369A1" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="32" Background="{StaticResource LiquidTopSheenBrush}" Margin="2" IsHitTestVisible="False" />
                <Border CornerRadius="32" BorderBrush="{StaticResource LiquidGlassActiveRimBrush}" BorderThickness="2" IsHitTestVisible="False" />
                <Path Data="{StaticResource IconGridCenterGeometry}"
                      Fill="#FFFFFF"
                      Stretch="Uniform"
                      Width="25"
                      Height="25"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- Trạng thái 2: Trung tâm điều khiển Liquid Glass nổi (phong cách Apple visionOS Control Center) -->
        <Grid x:Name="ExpandedMenuOverlay"
              Visibility="Collapsed"
              Background="#CC03060E"
              MouseLeftButtonDown="OnBackdropMouseLeftButtonDown">

            <Grid x:Name="MenuSheetContainer"
                  Width="820"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5"
                  ClipToBounds="False"
                  MouseLeftButtonDown="OnMenuCardMouseLeftButtonDown">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SheetScale" ScaleX="0.92" ScaleY="0.92" />
                        <TranslateTransform x:Name="SheetTranslate" X="0" Y="18" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Quầng sáng khúc xạ nền sau tấm kính -->
                <Ellipse Width="760"
                         Height="520"
                         Fill="{StaticResource CyanAmbientBloomBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />

                <!-- Tấm kính chính bo tròn lớn 36px -->
                <Border Background="{StaticResource LiquidDialogFillBrush}"
                        BorderBrush="{StaticResource LiquidGlassRimBrush}"
                        BorderThickness="1.8"
                        CornerRadius="36" />

                <!-- Lớp phản quang vòm kính phía trên -->
                <Border Background="{StaticResource LiquidTopSheenBrush}"
                        CornerRadius="36"
                        Margin="1.8"
                        IsHitTestVisible="False" />

                <StackPanel Margin="42,36" ClipToBounds="False">
                    <!-- Đầu bảng: Biểu tượng + Tiêu đề + Đồng hồ + Nút đóng tròn -->
                    <Grid Margin="0,0,0,26" ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                            <Border CornerRadius="16" Background="{StaticResource BrandLogoBrush}" />
                            <Border CornerRadius="16" Background="{StaticResource LiquidTopSheenBrush}" />
                            <Path Data="{StaticResource IconGridCenterGeometry}"
                                  Fill="#FFFFFF"
                                  Stretch="Uniform"
                                  Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Trung tâm điều khiển"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding VietnameseDateText}"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnCloseMenuClick"
                                MinHeight="52"
                                MinWidth="128"
                                Padding="20,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCloseGeometry}"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Đóng" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Nút Trang Chủ Hero Liquid Capsule -->
                    <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                            Click="OnGoHomeClick"
                            MinHeight="66"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHomeGeometry}"
                                  Fill="#FFFFFF"
                                  Stretch="Uniform"
                                  Width="24"
                                  Height="24"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Về Trang Chủ ZenBox" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Lưới 6 viên thuốc chuyển kênh nhanh kèm huy hiệu 3D Squircle -->
                    <TextBlock Text="Chuyển nhanh kênh giải trí"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="4,0,0,12" />

                    <UniformGrid Columns="3" Rows="2" Margin="-8,0,-8,22" ClipToBounds="False">
                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenYouTubeClick"
                                MinHeight="66"
                                Margin="8,0,8,14"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF3B5C" Offset="0" />
                                            <GradientStop Color="#DC2626" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="{StaticResource IconYouTubeGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="YouTube" FontSize="19" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenFacebookClick"
                                MinHeight="66"
                                Margin="8,0,8,14"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0" />
                                            <GradientStop Color="#1D4ED8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="{StaticResource IconFacebookGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Facebook" FontSize="19" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenTikTokClick"
                                MinHeight="66"
                                Margin="8,0,8,14"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#06B6D4" Offset="0" />
                                            <GradientStop Color="#EC4899" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="{StaticResource IconTikTokGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="TikTok" FontSize="19" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenWebBrowserClick"
                                MinHeight="66"
                                Margin="8,0,8,0"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#38BDF8" Offset="0" />
                                            <GradientStop Color="#6366F1" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="{StaticResource IconGlobeGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Trình duyệt" FontSize="19" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenMoviesClick"
                                MinHeight="66"
                                Margin="8,0,8,0"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F59E0B" Offset="0" />
                                            <GradientStop Color="#EA580C" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="{StaticResource IconMovieGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Phim Offline" FontSize="19" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenMusicClick"
                                MinHeight="66"
                                Margin="8,0,8,0"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#A855F7" Offset="0" />
                                            <GradientStop Color="#EC4899" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="{StaticResource IconMusicGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Nhạc Offline" FontSize="19" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Thanh chỉnh âm lượng kính mờ -->
                    <Border Background="#16FFFFFF"
                            BorderBrush="#2AFFFFFF"
                            BorderThickness="1.2"
                            CornerRadius="26"
                            Padding="18,14"
                            Margin="0,0,0,20">
                        <Grid ClipToBounds="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource GlassActionButtonStyle}"
                                    Click="OnVolumeDownClick"
                                    MinHeight="58">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconVolDownGeometry}"
                                          Fill="{StaticResource TextPrimaryBrush}"
                                          Stretch="Uniform"
                                          Width="22"
                                          Height="22"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Giảm âm lượng" FontSize="19" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="1"
                                       Text="Âm lượng TV"
                                       FontSize="18"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="22,0" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryCyanButtonStyle}"
                                    Click="OnVolumeUpClick"
                                    MinHeight="58">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconVolUpGeometry}"
                                          Fill="#FFFFFF"
                                          Stretch="Uniform"
                                          Width="22"
                                          Height="22"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Tăng âm lượng" FontSize="19" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Nút Thoát ZenBox -->
                    <Button Style="{StaticResource CoralWarningButtonStyle}"
                            Click="OnExitAppClick"
                            MinHeight="58"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPowerGeometry}"
                                  Fill="{StaticResource WarningCoralBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Thoát ứng dụng ZenBox" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
