<Window x:Class="ZenBox.Views.FloatingMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trung tâm điều khiển nổi ZenBox"
        Width="96"
        Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid ClipToBounds="False">
        <!-- Trạng thái 1: Viên ngọc Liquid Glass Orb 64x64px -->
        <Grid x:Name="AssistiveBallContainer"
              Width="96"
              Height="96"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ClipToBounds="False">
            <Grid x:Name="AssistiveBall"
                  Width="62"
                  Height="62"
                  Cursor="Hand"
                  RenderTransformOrigin="0.5,0.5"
                  ToolTip="Bấm mở Trung tâm điều khiển hoặc giữ chuột để kéo đi"
                  PreviewMouseLeftButtonDown="OnBallMouseLeftButtonDown"
                  PreviewMouseMove="OnBallMouseMove"
                  PreviewMouseLeftButtonUp="OnBallMouseLeftButtonUp">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.12" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.12" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Ellipse Margin="-10" Fill="{StaticResource CyanAmbientBloomBrush}" IsHitTestVisible="False" />
                <Border CornerRadius="31" Background="#CC0F172A" />
                <Border CornerRadius="31" Background="{StaticResource LiquidGlassFillBrush}" />
                <Border CornerRadius="31" Background="{StaticResource LiquidTopSheenBrush}" Margin="1.5" IsHitTestVisible="False" />
                <Border CornerRadius="31" BorderBrush="{StaticResource LiquidGlassActiveRimBrush}" BorderThickness="1.8" IsHitTestVisible="False" />
                <Path Data="{StaticResource IconGridCenterGeometry}"
                      Fill="#FFFFFF"
                      Stretch="Uniform"
                      Width="24"
                      Height="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- Trạng thái 2: Bảng Liquid Glass Dock hiện đại (Chỉ dùng Logo thuần khiết trong Dock chuyển ứng dụng) -->
        <Grid x:Name="ExpandedMenuOverlay"
              Visibility="Collapsed"
              Background="#C803060E"
              MouseLeftButtonDown="OnBackdropMouseLeftButtonDown">

            <Grid x:Name="MenuSheetContainer"
                  Width="760"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5"
                  ClipToBounds="False"
                  MouseLeftButtonDown="OnMenuCardMouseLeftButtonDown">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SheetScale" ScaleX="0.92" ScaleY="0.92" />
                        <TranslateTransform x:Name="SheetTranslate" X="0" Y="18" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Ellipse Width="700"
                         Height="480"
                         Fill="{StaticResource CyanAmbientBloomBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />

                <Border Background="{StaticResource LiquidDialogFillBrush}"
                        BorderBrush="{StaticResource LiquidGlassRimBrush}"
                        BorderThickness="1.8"
                        CornerRadius="36" />

                <Border Background="{StaticResource LiquidTopSheenBrush}"
                        CornerRadius="36"
                        Margin="1.8"
                        IsHitTestVisible="False" />

                <StackPanel Margin="38,34" ClipToBounds="False">
                    <!-- Hàng 1: Điều hướng nhanh trong ứng dụng & Về Trang Chủ -->
                    <Grid Margin="0,0,0,22" ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnAppBackClick"
                                MinHeight="56"
                                MinWidth="140"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBackGeometry}"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      Stretch="Uniform"
                                      Width="18"
                                      Height="18"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Quay lại" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryCyanButtonStyle}"
                                Click="OnGoHomeClick"
                                MinHeight="56"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHomeGeometry}"
                                      Fill="#FFFFFF"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Trang Chủ" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnAppReloadClick"
                                ToolTip="Tải lại ứng dụng hiện tại"
                                MinHeight="56"
                                MinWidth="68"
                                Padding="0"
                                Margin="0,0,12,0">
                            <Path Data="{StaticResource IconRefreshGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20" />
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnCloseMenuClick"
                                ToolTip="Đóng bảng điều khiển"
                                MinHeight="56"
                                MinWidth="68"
                                Padding="0">
                            <Path Data="{StaticResource IconCloseGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18" />
                        </Button>
                    </Grid>

                    <!-- Hàng 2: Dock chuyển ứng dụng nhanh — Chỉ dùng Logo thuần khiết không chữ, không hộp màu -->
                    <UniformGrid Columns="4" Rows="2" Margin="-8,0,-8,20" ClipToBounds="False">
                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenYouTubeClick"
                                ToolTip="YouTube"
                                Height="92"
                                Margin="8,0,8,14"
                                Padding="0">
                            <Image x:Name="DockYouTubeImg" Width="54" Height="54" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenNetflixClick"
                                ToolTip="Netflix"
                                Height="92"
                                Margin="8,0,8,14"
                                Padding="0">
                            <Image x:Name="DockNetflixImg" Width="54" Height="54" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenSpotifyClick"
                                ToolTip="Spotify"
                                Height="92"
                                Margin="8,0,8,14"
                                Padding="0">
                            <Image x:Name="DockSpotifyImg" Width="54" Height="54" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenTikTokClick"
                                ToolTip="TikTok"
                                Height="92"
                                Margin="8,0,8,14"
                                Padding="0">
                            <Image x:Name="DockTikTokImg" Width="54" Height="54" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenFacebookClick"
                                ToolTip="Facebook"
                                Height="92"
                                Margin="8,0,8,0"
                                Padding="0">
                            <Image x:Name="DockFacebookImg" Width="52" Height="52" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenWebBrowserClick"
                                ToolTip="Tìm kiếm Google"
                                Height="92"
                                Margin="8,0,8,0"
                                Padding="0">
                            <Image x:Name="DockGoogleImg" Width="52" Height="52" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenMoviesClick"
                                ToolTip="Phim của tôi"
                                Height="92"
                                Margin="8,0,8,0"
                                Padding="0">
                            <Image x:Name="DockMoviesImg" Width="54" Height="54" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenMusicClick"
                                ToolTip="Nhạc của tôi"
                                Height="92"
                                Margin="8,0,8,0"
                                Padding="0">
                            <Image x:Name="DockMusicImg" Width="54" Height="54" Stretch="Uniform" />
                        </Button>
                    </UniformGrid>

                    <!-- Hàng 3: Cụm Âm lượng & Nút Thoát gọn đẹp -->
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnVolumeDownClick"
                                MinHeight="58">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconVolDownGeometry}"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      Stretch="Uniform"
                                      Width="22"
                                      Height="22"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Giảm âm lượng" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryCyanButtonStyle}"
                                Click="OnVolumeUpClick"
                                MinHeight="58">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconVolUpGeometry}"
                                      Fill="#FFFFFF"
                                      Stretch="Uniform"
                                      Width="22"
                                      Height="22"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Tăng âm lượng" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource CoralWarningButtonStyle}"
                                Click="OnExitAppClick"
                                ToolTip="Thoát ZenBox"
                                MinHeight="58"
                                MinWidth="148">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPowerGeometry}"
                                      Fill="{StaticResource WarningCoralBrush}"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Thoát" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
