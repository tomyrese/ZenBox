<Window x:Class="ZenBox.Views.FloatingMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trung tâm điều khiển nổi ZenBox"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Opacity="0"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <!-- Cửa sổ Popup giữ nguyên kích thước màn hình cố định trong VRAM kết hợp WS_EX_TRANSPARENT giúp mở/đóng 0ms KHÔNG BAO GIỜ NHÁY HÌNH (Zero-Flicker) -->
    <Grid x:Name="ExpandedMenuOverlay"
          Background="#CC02050B"
          MouseLeftButtonDown="OnBackdropMouseLeftButtonDown">

        <Grid x:Name="MenuSheetContainer"
              Width="820"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5"
              ClipToBounds="False"
              MouseLeftButtonDown="OnMenuCardMouseLeftButtonDown">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SheetScale" ScaleX="0.94" ScaleY="0.94" />
                    <TranslateTransform x:Name="SheetTranslate" X="0" Y="14" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse Width="740"
                     Height="520"
                     Fill="{StaticResource CyanAmbientBloomBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />

            <Border Background="{StaticResource LiquidDialogFillBrush}"
                    BorderBrush="{StaticResource LiquidGlassRimBrush}"
                    BorderThickness="1.5"
                    CornerRadius="36" />

            <Border Height="1.2"
                    VerticalAlignment="Top"
                    Margin="40,1,40,0"
                    Background="{StaticResource LiquidTopHairlineBrush}"
                    IsHitTestVisible="False" />

            <StackPanel Margin="36,32" ClipToBounds="False">
                <!-- Hàng 1: Điều hướng nhanh + Cài đặt + Làm mới + Đóng -->
                <Grid Margin="0,0,0,20" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Click="OnAppBackClick"
                            MinHeight="54"
                            MinWidth="140"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBackGeometry}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Quay lại" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryCyanButtonStyle}"
                            Click="OnGoHomeClick"
                            MinHeight="54"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHomeGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Trang Chủ" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Click="OnOpenSettingsClick"
                            MinHeight="54"
                            MinWidth="132"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSlidersGeometry}" Fill="{StaticResource AccentCyanBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Cài đặt" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Click="OnAppReloadClick"
                            ToolTip="Tải lại ứng dụng"
                            MinHeight="54"
                            MinWidth="62"
                            Padding="0"
                            Margin="0,0,10,0">
                        <Path Data="{StaticResource IconRefreshGeometry}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" Width="19" Height="19" />
                    </Button>

                    <Button Grid.Column="4"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Click="OnCloseMenuClick"
                            ToolTip="Đóng"
                            MinHeight="54"
                            MinWidth="62"
                            Padding="0">
                        <Path Data="{StaticResource IconCloseGeometry}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" Width="18" Height="18" />
                    </Button>
                </Grid>

                <!-- Hàng 2: Dock chuyển nhanh 8 ứng dụng bằng Logo thuần khiết -->
                <UniformGrid Columns="4" Rows="2" Margin="-7,0,-7,18" ClipToBounds="False">
                    <Button Style="{StaticResource GlassActionButtonStyle}" Click="OnOpenYouTubeClick" ToolTip="YouTube" Height="86" Margin="7,0,7,12" Padding="0">
                        <Image x:Name="DockYouTubeImg" Width="50" Height="50" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource GlassActionButtonStyle}" Click="OnOpenNetflixClick" ToolTip="Netflix" Height="86" Margin="7,0,7,12" Padding="0">
                        <Image x:Name="DockNetflixImg" Width="50" Height="50" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource GlassActionButtonStyle}" Click="OnOpenSpotifyClick" ToolTip="Spotify" Height="86" Margin="7,0,7,12" Padding="0">
                        <Image x:Name="DockSpotifyImg" Width="50" Height="50" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource GlassActionButtonStyle}" Click="OnOpenTikTokClick" ToolTip="TikTok" Height="86" Margin="7,0,7,12" Padding="0">
                        <Image x:Name="DockTikTokImg" Width="50" Height="50" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource GlassActionButtonStyle}" Click="OnOpenFacebookClick" ToolTip="Facebook" Height="86" Margin="7,0,7,0" Padding="0">
                        <Image x:Name="DockFacebookImg" Width="48" Height="48" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource GlassActionButtonStyle}" Click="OnOpenWebBrowserClick" ToolTip="Tìm kiếm Google" Height="86" Margin="7,0,7,0" Padding="0">
                        <Image x:Name="DockGoogleImg" Width="48" Height="48" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource GlassActionButtonStyle}" Click="OnOpenMoviesClick" ToolTip="Phim của tôi" Height="86" Margin="7,0,7,0" Padding="0">
                        <Image x:Name="DockMoviesImg" Width="50" Height="50" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource GlassActionButtonStyle}" Click="OnOpenMusicClick" ToolTip="Nhạc của tôi" Height="86" Margin="7,0,7,0" Padding="0">
                        <Image x:Name="DockMusicImg" Width="50" Height="50" Stretch="Uniform" />
                    </Button>
                </UniformGrid>

                <!-- Hàng 3: Thanh kéo Âm lượng trực tiếp 0-100% -->
                <Border Background="#14FFFFFF"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1.2"
                        CornerRadius="24"
                        Padding="20,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="68" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Command="{Binding ToggleSystemMuteCommand}"
                                MinHeight="48"
                                MinWidth="58"
                                Padding="0"
                                Margin="0,0,16,0">
                            <Path Stretch="Uniform" Width="20" Height="20" Fill="{StaticResource AccentCyanBrush}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconVolUpGeometry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemMuted}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconMuteGeometry}" />
                                                <Setter Property="Fill" Value="{StaticResource WarningCoralBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Slider Grid.Column="1"
                                Style="{StaticResource ModernMediaSliderStyle}"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding QuickVolumePercent, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding QuickVolumePercent, StringFormat='{}{0}%'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Hàng 4: Cụm công tắc nhanh EQ Âm thanh, Lọc ánh sáng xanh, Hẹn giờ ngủ & Thoát -->
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding CycleQuickAudioPresetCommand}"
                            MinHeight="54"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconEqualizerGeometry}" Fill="{StaticResource AccentCyanBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding QuickAudioPresetLabel}" FontSize="18" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding CycleQuickEyeCareCommand}"
                            MinHeight="54"
                            Padding="14,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GlassActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEyeCareActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource LiquidWarmAmberPillBrush}" />
                                        <Setter Property="BorderBrush" Value="#AAFFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconMoonGeometry}" Fill="#FDE68A" Stretch="Uniform" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding QuickEyeCareLabel}" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            Command="{Binding CycleQuickSleepTimerCommand}"
                            MinHeight="54"
                            Padding="14,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GlassActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSleepTimerActive}" Value="True">
                                        <Setter Property="Background" Value="#3034D399" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessGreenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTimerGeometry}" Fill="#34D399" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SleepTimerBadgeText}" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="6"
                            Style="{StaticResource CoralWarningButtonStyle}"
                            Click="OnExitAppClick"
                            MinHeight="54"
                            MinWidth="128"
                            Padding="18,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPowerGeometry}" Fill="{StaticResource WarningCoralBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Thoát" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
