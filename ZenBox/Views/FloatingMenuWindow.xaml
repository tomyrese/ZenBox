<Window x:Class="ZenBox.Views.FloatingMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng trợ năng nổi ZenBox"
        Width="88"
        Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid>
        <!-- Trạng thái 1: Nút tròn nổi 64x64px thiết kế kính mờ hiện đại (kiểu Control Center tvOS) -->
        <Grid x:Name="AssistiveBallContainer"
              Width="88"
              Height="88"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border x:Name="AssistiveBall"
                    Width="64"
                    Height="64"
                    CornerRadius="32"
                    BorderBrush="#7DD3FC"
                    BorderThickness="2"
                    Cursor="Hand"
                    ToolTip="Bấm mở Điều khiển nhanh hoặc giữ chuột để kéo đi"
                    PreviewMouseLeftButtonDown="OnBallMouseLeftButtonDown"
                    PreviewMouseMove="OnBallMouseMove"
                    PreviewMouseLeftButtonUp="OnBallMouseLeftButtonUp">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E61E293B" Offset="0" />
                        <GradientStop Color="#EB0F172A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <Path Data="{StaticResource IconGridCenterGeometry}"
                      Fill="{StaticResource AccentCyanBrush}"
                      Stretch="Uniform"
                      Width="26"
                      Height="26"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Trạng thái 2: Bảng Điều Khiển Nhanh căn đối xứng tuyệt đối -->
        <Grid x:Name="ExpandedMenuOverlay"
              Visibility="Collapsed"
              Background="#CC04070E"
              MouseLeftButtonDown="OnBackdropMouseLeftButtonDown">
            <Border Width="780"
                    Padding="38,34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F50D1424"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1.5"
                    CornerRadius="28"
                    MouseLeftButtonDown="OnMenuCardMouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.6" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Hàng tiêu đề + Nút đóng Vector -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Điều khiển nhanh ZenBox"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnCloseMenuClick"
                                MinHeight="56"
                                MinWidth="130">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCloseGeometry}"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      Stretch="Uniform"
                                      Width="18"
                                      Height="18"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Đóng" FontSize="19" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Nút Trang Chủ cố định nổi bật -->
                    <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                            Click="OnGoHomeClick"
                            MinHeight="64"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHomeGeometry}"
                                  Fill="#FFFFFF"
                                  Stretch="Uniform"
                                  Width="22"
                                  Height="22"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Về Trang Chủ" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Lưới chuyển nhanh 6 kênh đối xứng 3 cột x 2 hàng thẳng tắp -->
                    <TextBlock Text="Chuyển nhanh kênh giải trí"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <UniformGrid Columns="3" Rows="2" Margin="-8,0,-8,20">
                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenYouTubeClick"
                                MinHeight="62"
                                Margin="8,0,8,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconYouTubeGeometry}"
                                      Fill="#F87171"
                                      Stretch="Uniform"
                                      Width="22"
                                      Height="22"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="YouTube" FontSize="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenFacebookClick"
                                MinHeight="62"
                                Margin="8,0,8,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFacebookGeometry}"
                                      Fill="#60A5FA"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Facebook" FontSize="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenTikTokClick"
                                MinHeight="62"
                                Margin="8,0,8,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTikTokGeometry}"
                                      Fill="#2DD4BF"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="TikTok" FontSize="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenWebBrowserClick"
                                MinHeight="62"
                                Margin="8,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGlobeGeometry}"
                                      Fill="#38BDF8"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Trình duyệt" FontSize="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenMoviesClick"
                                MinHeight="62"
                                Margin="8,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMovieGeometry}"
                                      Fill="#FBBF24"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Phim Offline" FontSize="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenMusicClick"
                                MinHeight="62"
                                Margin="8,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMusicGeometry}"
                                      Fill="#C084FC"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Nhạc Offline" FontSize="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Cụm âm lượng hệ thống đối xứng 2 cột -->
                    <TextBlock Text="Âm lượng loa máy tính / TV"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <UniformGrid Columns="2" Margin="-8,0,-8,24">
                        <Button Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnVolumeDownClick"
                                MinHeight="62"
                                Margin="8,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconVolDownGeometry}"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      Stretch="Uniform"
                                      Width="22"
                                      Height="22"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Giảm âm lượng (-)" FontSize="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                                Click="OnVolumeUpClick"
                                MinHeight="62"
                                Margin="8,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconVolUpGeometry}"
                                      Fill="#FFFFFF"
                                      Stretch="Uniform"
                                      Width="22"
                                      Height="22"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Tăng âm lượng (+)" FontSize="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Nút Thoát ZenBox -->
                    <Button Style="{StaticResource CoralWarningButtonStyle}"
                            Click="OnExitAppClick"
                            MinHeight="60"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPowerGeometry}"
                                  Fill="{StaticResource WarningCoralBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Thoát ZenBox" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
