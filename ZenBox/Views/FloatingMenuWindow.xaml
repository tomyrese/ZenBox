<Window x:Class="ZenBox.Views.FloatingMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng trợ năng nổi ZenBox"
        Width="88"
        Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid>
        <!-- Trạng thái 1: Nút tròn nổi AssistiveTouch 64x64px có thể kéo thả mọi nơi -->
        <Grid x:Name="AssistiveBallContainer"
              Width="88"
              Height="88"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border x:Name="AssistiveBall"
                    Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="#D90F172A"
                    BorderBrush="{StaticResource AccentCyanBrush}"
                    BorderThickness="3"
                    Cursor="Hand"
                    ToolTip="Bấm để mở Bảng điều khiển nhanh hoặc giữ chuột để kéo đi"
                    PreviewMouseLeftButtonDown="OnBallMouseLeftButtonDown"
                    PreviewMouseMove="OnBallMouseMove"
                    PreviewMouseLeftButtonUp="OnBallMouseLeftButtonUp">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <Border Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="#5538BDF8"
                        BorderBrush="#CCFFFFFF"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Ellipse Width="14"
                             Height="14"
                             Fill="#F8FAFC"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
            </Border>
        </Grid>

        <!-- Trạng thái 2: Bảng điều khiển nổi kính mờ cỡ lớn -->
        <Grid x:Name="ExpandedMenuOverlay"
              Visibility="Collapsed"
              Background="#A8060912"
              MouseLeftButtonDown="OnBackdropMouseLeftButtonDown">
            <Border MaxWidth="820"
                    Padding="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F00F172A"
                    BorderBrush="{StaticResource AccentCyanBrush}"
                    BorderThickness="2"
                    CornerRadius="24"
                    MouseLeftButtonDown="OnMenuCardMouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.4" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Điều khiển nhanh ZenBox"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="✕ Đóng"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnCloseMenuClick"
                                MinHeight="56"
                                MinWidth="130" />
                    </Grid>

                    <!-- Nút Trang Chủ cố định cỡ lớn -->
                    <Button Content="⌂ Về Trang Chủ"
                            Style="{StaticResource PrimaryCyanButtonStyle}"
                            Click="OnGoHomeClick"
                            MinHeight="66"
                            FontSize="24"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,22" />

                    <!-- Chuyển nhanh ứng dụng -->
                    <TextBlock Text="Chuyển nhanh kênh giải trí:"
                               FontSize="20"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,14" />

                    <WrapPanel Margin="0,0,0,18">
                        <Button Content="▶ YouTube"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenYouTubeClick"
                                MinHeight="60"
                                MinWidth="215"
                                Margin="0,0,20,16" />
                        <Button Content="f Facebook"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenFacebookClick"
                                MinHeight="60"
                                MinWidth="215"
                                Margin="0,0,20,16" />
                        <Button Content="♪ TikTok"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenTikTokClick"
                                MinHeight="60"
                                MinWidth="215"
                                Margin="0,0,0,16" />
                        <Button Content="🎬 Phim Offline"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenMoviesClick"
                                MinHeight="60"
                                MinWidth="215"
                                Margin="0,0,20,8" />
                        <Button Content="🎵 Nhạc Offline"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnOpenMusicClick"
                                MinHeight="60"
                                MinWidth="215"
                                Margin="0,0,20,8" />
                    </WrapPanel>

                    <!-- Cụm nút Tăng / Giảm âm lượng hệ thống Windows 11 -->
                    <TextBlock Text="Âm lượng loa máy tính / TV:"
                               FontSize="20"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="🔉 Giảm âm lượng (-)"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Click="OnVolumeDownClick"
                                MinHeight="64"
                                FontSize="22" />
                        <Button Grid.Column="2"
                                Content="🔊 Tăng âm lượng (+)"
                                Style="{StaticResource PrimaryCyanButtonStyle}"
                                Click="OnVolumeUpClick"
                                MinHeight="64"
                                FontSize="22" />
                    </Grid>

                    <!-- Nút Thoát ZenBox -->
                    <Button Content="⏻ Thoát ZenBox"
                            Style="{StaticResource CoralWarningButtonStyle}"
                            Click="OnExitAppClick"
                            MinHeight="60"
                            FontSize="22"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
