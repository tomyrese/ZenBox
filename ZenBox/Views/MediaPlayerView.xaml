<UserControl x:Class="ZenBox.Views.MediaPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             FontFamily="{StaticResource PrimaryFontFamily}"
             Loaded="OnMediaPlayerLoaded"
             Unloaded="OnMediaPlayerUnloaded">

    <Grid Background="#03050B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề trên cùng -->
        <Border Grid.Row="0"
                Background="#E6060A14"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="52,14"
                Visibility="{Binding IsControlsVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding BackToLibraryCommand}"
                        MinHeight="54"
                        Margin="0,0,22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBackGeometry}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Thư viện" FontSize="18" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding MediaTitle}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Cụm tinh chỉnh nhanh Âm thanh EQ, Tốc độ & Khung hình ngay khi xem -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="False">
                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding CycleSoundPresetCommand}"
                            ToolTip="Đổi nhanh chế độ âm thanh EQ 10 dải tần"
                            MinHeight="50"
                            Padding="18,8"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconEqualizerGeometry}"
                                  Fill="{StaticResource AccentCyanBrush}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SoundPresetLabel}" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding CyclePlaybackSpeedCommand}"
                            ToolTip="Đổi tốc độ phát"
                            MinHeight="50"
                            MinWidth="96"
                            Padding="16,8"
                            Margin="0,0,12,0">
                        <TextBlock Text="{Binding SpeedLabel}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding CycleAspectRatioCommand}"
                            Visibility="{Binding IsVideoTrack, Converter={StaticResource BoolToVis}}"
                            ToolTip="Đổi tỷ lệ khung hình"
                            MinHeight="50"
                            Padding="18,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconAspectGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AspectLabel}" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vùng hiển thị Video / Bìa Nhạc -->
        <Grid Grid.Row="1">
            <vlc:VideoView x:Name="VlcVideoSurface"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Background="#000000"
                           Visibility="{Binding IsVideoTrack, Converter={StaticResource BoolToVis}}" />

            <Grid Visibility="{Binding IsAudioTrack, Converter={StaticResource BoolToVis}}">
                <Ellipse Width="520"
                         Height="520"
                         Fill="{StaticResource CyanAmbientBloomBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                <Border Width="520"
                        Padding="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource GlassPanelBorderStyle}"
                        CornerRadius="36">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="250"
                                Height="250"
                                CornerRadius="30"
                                ClipToBounds="True"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1.5"
                                Margin="0,0,0,24">
                            <Image Source="{Binding CurrentMedia.CoverImage}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{Binding MediaTitle}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SoundPresetLabel, StringFormat='Chế độ âm thanh: {0}'}"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Thanh điều khiển phát dưới cùng -->
        <Border Grid.Row="2"
                Background="#EE060A14"
                BorderBrush="#24FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="52,16,52,20"
                Visibility="{Binding IsControlsVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,16" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTimeText}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentCyanBrush}"
                               VerticalAlignment="Center" />

                    <Slider x:Name="TimelineSlider"
                            Grid.Column="1"
                            Style="{StaticResource ModernMediaSliderStyle}"
                            Minimum="0"
                            Maximum="1000"
                            Value="{Binding ProgressValue, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            Cursor="Hand"
                            Thumb.DragStarted="OnSliderDragStarted"
                            Thumb.DragCompleted="OnSliderDragCompleted"
                            PreviewMouseLeftButtonUp="OnSliderMouseLeftButtonUp" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalDurationText}"
                               FontSize="19"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <WrapPanel HorizontalAlignment="Center" ClipToBounds="False">
                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding RestartFromBeginningCommand}"
                            MinHeight="58"
                            MinWidth="175"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRestartGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Xem từ đầu" FontSize="19" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding Rewind15SecondsCommand}"
                            MinHeight="58"
                            MinWidth="195"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRewindGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Lùi 15 giây" FontSize="19" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                            Command="{Binding TogglePlayPauseCommand}"
                            MinHeight="58"
                            MinWidth="220"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Stretch="Uniform"
                                  Width="19"
                                  Height="19"
                                  Fill="#FFFFFF"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconPlayGeometry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconPauseGeometry}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding PlayPauseButtonText}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding Forward15SecondsCommand}"
                            MinHeight="58"
                            MinWidth="195">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tới 15 giây" FontSize="19" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource IconForwardGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
