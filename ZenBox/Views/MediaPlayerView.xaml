<UserControl x:Class="ZenBox.Views.MediaPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             FontFamily="{StaticResource PrimaryFontFamily}"
             Unloaded="OnMediaPlayerUnloaded">

    <!-- Bố cục 3 hàng độc lập: Không nhét phần tử con vào VideoView để triệt tiêu hoàn toàn lỗi cửa sổ phủ đè lên màn hình khác -->
    <Grid Background="#05080F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hàng 0: Thanh tiêu đề trên cùng (tự ẩn khi xem phim sau 3 giây không di chuột) -->
        <Border Grid.Row="0"
                Background="#E60B0F19"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="56,16"
                Visibility="{Binding IsControlsVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding BackToLibraryCommand}"
                        MinHeight="56"
                        Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBackGeometry}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Quay lại thư viện" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{Binding MediaTitle}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Hàng 1: Khung hiển thị Video hoặc Bìa Đĩa Nhạc -->
        <Grid Grid.Row="1">
            <vlc:VideoView x:Name="VlcVideoSurface"
                           MediaPlayer="{Binding VlcPlayer}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Background="#000000"
                           Visibility="{Binding IsVideoTrack, Converter={StaticResource BoolToVis}}" />

            <!-- Giao diện thưởng thức Nhạc sang trọng -->
            <Border MaxWidth="540"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource GlassPanelBorderStyle}"
                    Background="#CC0F172A"
                    Visibility="{Binding IsAudioTrack, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="260"
                            Height="260"
                            CornerRadius="28"
                            ClipToBounds="True"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1.5"
                            Margin="0,0,0,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.5" Color="#000000" />
                        </Border.Effect>
                        <Image Source="{Binding CurrentMedia.CoverImage}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding MediaTitle}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Đang phát từ thư viện nhạc trong máy"
                               FontSize="18"
                               Foreground="{StaticResource AccentCyanBrush}"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hàng 2: Thanh điều khiển phát Media hiện đại (tự ẩn sau 3 giây khi xem phim) -->
        <Border Grid.Row="2"
                Background="#F00B0F19"
                BorderBrush="#26FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="56,20,56,22"
                Visibility="{Binding IsControlsVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Thanh tiến trình bo tròn mượt mà -->
                <Grid Margin="0,0,0,18" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTimeText}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentCyanBrush}"
                               VerticalAlignment="Center" />

                    <Slider x:Name="TimelineSlider"
                            Grid.Column="1"
                            Style="{StaticResource ModernMediaSliderStyle}"
                            Minimum="0"
                            Maximum="1000"
                            Value="{Binding ProgressValue, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            Cursor="Hand"
                            Thumb.DragStarted="OnSliderDragStarted"
                            Thumb.DragCompleted="OnSliderDragCompleted"
                            PreviewMouseLeftButtonUp="OnSliderMouseLeftButtonUp" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalDurationText}"
                               FontSize="20"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Cụm nút điều khiển đồng bộ kích thước và biểu tượng Vector -->
                <WrapPanel HorizontalAlignment="Center">
                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding Rewind15SecondsCommand}"
                            MinHeight="60"
                            MinWidth="215"
                            Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRewindGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Tua lùi 15 giây" FontSize="20" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                            Command="{Binding TogglePlayPauseCommand}"
                            MinHeight="60"
                            MinWidth="230"
                            Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Fill="#FFFFFF"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconPlayGeometry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconPauseGeometry}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding PlayPauseButtonText}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding Forward15SecondsCommand}"
                            MinHeight="60"
                            MinWidth="215"
                            Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tua tới 15 giây" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource IconForwardGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding BackToLibraryCommand}"
                            MinHeight="60"
                            MinWidth="215">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBackGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Quay lại thư viện" FontSize="20" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
