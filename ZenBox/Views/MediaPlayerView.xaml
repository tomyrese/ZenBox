<UserControl x:Class="ZenBox.Views.MediaPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             FontFamily="{StaticResource PrimaryFontFamily}"
             Loaded="OnMediaPlayerLoaded"
             Unloaded="OnMediaPlayerUnloaded">

    <Grid Background="#04070E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề Liquid Glass phía trên -->
        <Border Grid.Row="0"
                Background="#D9080D1A"
                BorderBrush="#24FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="56,14"
                Visibility="{Binding IsControlsVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding BackToLibraryCommand}"
                        MinHeight="56"
                        Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBackGeometry}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Quay lại thư viện" FontSize="19" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{Binding MediaTitle}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Khung hiển thị Video / Đĩa Nhạc -->
        <Grid Grid.Row="1">
            <vlc:VideoView x:Name="VlcVideoSurface"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Background="#000000"
                           Visibility="{Binding IsVideoTrack, Converter={StaticResource BoolToVis}}" />

            <!-- Đảo kính thưởng thức Nhạc Liquid Glass -->
            <Grid Visibility="{Binding IsAudioTrack, Converter={StaticResource BoolToVis}}">
                <Ellipse Width="520"
                         Height="520"
                         Fill="{StaticResource CyanAmbientBloomBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                <Border Width="520"
                        Padding="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource GlassPanelBorderStyle}"
                        CornerRadius="36">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="260"
                                Height="260"
                                CornerRadius="30"
                                ClipToBounds="True"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1.5"
                                Margin="0,0,0,26">
                            <Image Source="{Binding CurrentMedia.CoverImage}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{Binding MediaTitle}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Đang phát từ thư viện nhạc trong máy"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Thanh điều khiển phát Media Liquid Glass phía dưới -->
        <Border Grid.Row="2"
                Background="#E6080D1A"
                BorderBrush="#28FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="56,18,56,22"
                Visibility="{Binding IsControlsVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,18" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTimeText}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentCyanBrush}"
                               VerticalAlignment="Center" />

                    <Slider x:Name="TimelineSlider"
                            Grid.Column="1"
                            Style="{StaticResource ModernMediaSliderStyle}"
                            Minimum="0"
                            Maximum="1000"
                            Value="{Binding ProgressValue, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            Cursor="Hand"
                            Thumb.DragStarted="OnSliderDragStarted"
                            Thumb.DragCompleted="OnSliderDragCompleted"
                            PreviewMouseLeftButtonUp="OnSliderMouseLeftButtonUp" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalDurationText}"
                               FontSize="20"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <WrapPanel HorizontalAlignment="Center" ClipToBounds="False">
                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding Rewind15SecondsCommand}"
                            MinHeight="60"
                            MinWidth="215"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRewindGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Tua lùi 15 giây" FontSize="20" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                            Command="{Binding TogglePlayPauseCommand}"
                            MinHeight="60"
                            MinWidth="230"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Fill="#FFFFFF"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconPlayGeometry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconPauseGeometry}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding PlayPauseButtonText}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding Forward15SecondsCommand}"
                            MinHeight="60"
                            MinWidth="215"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tua tới 15 giây" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource IconForwardGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding BackToLibraryCommand}"
                            MinHeight="60"
                            MinWidth="215">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBackGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Quay lại thư viện" FontSize="20" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
