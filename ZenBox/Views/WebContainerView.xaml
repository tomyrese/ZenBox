<UserControl x:Class="ZenBox.Views.WebContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <!-- Các ứng dụng (YouTube, Netflix, Spotify, TikTok, Facebook...) chạy tràn viền 100% toàn màn hình không có bất kỳ thanh trình duyệt nào như App thực thụ -->
    <Grid Background="#060913">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Riêng công cụ Tìm kiếm Google mới hiện thanh nhập từ khóa Liquid Glass gọn nhẹ -->
        <Border Grid.Row="0"
                Background="#DD070B14"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="40,12"
                Visibility="{Binding IsSearchBarVisible, Converter={StaticResource BoolToVis}}">
            <Grid ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding GoBackCommand}"
                        MinHeight="52"
                        MinWidth="130"
                        Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBackGeometry}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Quay lại" FontSize="18" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#1EFFFFFF"
                            BorderBrush="{StaticResource LiquidGlassRimBrush}"
                            BorderThickness="1.4"
                            CornerRadius="24"
                            Padding="22,10"
                            Margin="0,0,12,0">
                        <TextBox Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentCyanBrush}"
                                 FontSize="19"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnAddressBoxKeyDown" />
                    </Border>
                    <Button Grid.Column="1"
                            Content="Tìm kiếm"
                            Style="{StaticResource PrimaryCyanButtonStyle}"
                            Command="{Binding NavigateToAddressCommand}"
                            MinHeight="52"
                            MinWidth="135" />
                </Grid>

                <Button Grid.Column="2"
                        Style="{StaticResource GlassActionButtonStyle}"
                        Command="{Binding GoHomeCommand}"
                        MinHeight="52"
                        MinWidth="150">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconHomeGeometry}"
                              Fill="{StaticResource AccentCyanBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Trang Chủ" FontSize="18" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Khung chứa các ứng dụng tràn 100% diện tích -->
        <Grid x:Name="BrowserHostGrid" Grid.Row="1" Background="#060913" />

        <!-- Màn hình Splash Logo kiểu Native App khi ứng dụng khởi động lần đầu (che hoàn toàn quá trình nạp trang web) -->
        <Grid Grid.Row="1"
              Background="#060913"
              Visibility="{Binding IsAppSplashVisible, Converter={StaticResource BoolToVis}}">
            <Ellipse Width="420"
                     Height="420"
                     Fill="{StaticResource CyanAmbientBloomBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding ActiveAppLogo}"
                       Width="124"
                       Height="124"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28" />

                <Border Background="#18FFFFFF"
                        BorderBrush="{StaticResource LiquidGlassRimBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="24,10"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Đang khởi động ứng dụng..."
                               FontSize="19"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
