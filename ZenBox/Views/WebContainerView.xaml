<UserControl x:Class="ZenBox.Views.WebContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Thanh điều hướng trình duyệt gọn, thẳng hàng 56px -->
        <Border Grid.Row="0"
                Background="#CC0B0F19"
                BorderBrush="#24FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="56,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding GoBackCommand}"
                            MinHeight="56"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBackGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Trang trước" FontSize="19" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassActionButtonStyle}"
                            Command="{Binding ReloadPageCommand}"
                            MinHeight="56"
                            Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefreshGeometry}"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Tải lại trang" FontSize="19" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Ô nhập địa chỉ khi mở Trình duyệt Web -->
                <Grid Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="0,0,20,0"
                      Visibility="{Binding IsAddressBarVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#1AFFFFFF"
                            BorderBrush="#36FFFFFF"
                            BorderThickness="1.2"
                            CornerRadius="16"
                            Padding="18,10"
                            Margin="0,0,14,0">
                        <TextBox Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentCyanBrush}"
                                 FontSize="20"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnAddressBoxKeyDown" />
                    </Border>
                    <Button Grid.Column="1"
                            Content="Đi tới"
                            Style="{StaticResource PrimaryCyanButtonStyle}"
                            Command="{Binding NavigateToAddressCommand}"
                            MinHeight="56"
                            MinWidth="130" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Đang mở trang..."
                               FontSize="18"
                               Foreground="{StaticResource AccentCyanBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PrimaryCyanButtonStyle}"
                            Command="{Binding GoHomeCommand}"
                            MinHeight="56">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHomeGeometry}"
                                  Fill="#FFFFFF"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Về Trang Chủ" FontSize="19" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="BrowserHostGrid" Grid.Row="1" Background="#0B0F19" />
    </Grid>
</UserControl>
