<Window x:Class="ZenBox.Views.FloatingOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cụm nút nổi ZenBox"
        Width="92"
        Height="164"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="False">

        <!-- Nút Trả Về Nhanh (Tự động xuất hiện ngay trên viên ngọc khi đang ở trong bất kỳ ứng dụng / màn hình con nào) -->
        <Grid x:Name="BackOrb"
              Width="58"
              Height="58"
              Margin="0,0,0,14"
              Cursor="Hand"
              RenderTransformOrigin="0.5,0.5"
              ToolTip="Trở về trang trước / Về Trang Chủ"
              Visibility="{Binding IsNotHome, Converter={StaticResource BoolToVis}}"
              PreviewMouseLeftButtonDown="OnBackOrbMouseDown"
              PreviewMouseMove="OnOrbMouseMove"
              PreviewMouseLeftButtonUp="OnBackOrbMouseUp">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.12" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.12" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Ellipse Margin="-8" Fill="{StaticResource CyanAmbientBloomBrush}" IsHitTestVisible="False" />
            <Border CornerRadius="29" Background="#E00B1324" />
            <Border CornerRadius="29" Background="{StaticResource LiquidCyanPillBrush}" Opacity="0.88" />
            <Border CornerRadius="29" BorderBrush="#CCFFFFFF" BorderThickness="1.8" IsHitTestVisible="False" />
            <Path Data="{StaticResource IconBackGeometry}"
                  Fill="#FFFFFF"
                  Stretch="Uniform"
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False" />
        </Grid>

        <!-- Viên ngọc mở Trung tâm điều khiển -->
        <Grid x:Name="MenuOrb"
              Width="58"
              Height="58"
              Cursor="Hand"
              RenderTransformOrigin="0.5,0.5"
              ToolTip="Mở Trung tâm điều khiển (hoặc giữ chuột để kéo đi)"
              PreviewMouseLeftButtonDown="OnMenuOrbMouseDown"
              PreviewMouseMove="OnOrbMouseMove"
              PreviewMouseLeftButtonUp="OnMenuOrbMouseUp">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.12" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.12" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Ellipse Margin="-8" Fill="{StaticResource CyanAmbientBloomBrush}" IsHitTestVisible="False" />
            <Border CornerRadius="29" Background="#DC0B1222" />
            <Border CornerRadius="29" Background="{StaticResource LiquidGlassFillBrush}" />
            <Border CornerRadius="29" BorderBrush="{StaticResource LiquidGlassActiveRimBrush}" BorderThickness="1.8" IsHitTestVisible="False" />
            <Path Data="{StaticResource IconGridCenterGeometry}"
                  Fill="#FFFFFF"
                  Stretch="Uniform"
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False" />
        </Grid>

    </StackPanel>
</Window>
