<UserControl x:Class="ZenBox.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="52,30,96,28" ClipToBounds="False">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,22">
                <Border Width="7" Height="26" CornerRadius="3.5" Background="{StaticResource LiquidCyanPillBrush}" Margin="0,0,14,0" />
                <TextBlock Text="Giải trí trực tuyến"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <!-- 14 ứng dụng trực tuyến căn chuẩn lưới 7 cột x 2 hàng cân đối tuyệt đối -->
            <ItemsControl ItemsSource="{Binding OnlineTiles}" Margin="0,4,0,22" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlassTileButtonStyle}"
                                Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Title}"
                                MinWidth="196"
                                MinHeight="164"
                                Width="200"
                                Height="166"
                                Padding="0"
                                Margin="0,0,24,24">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False">
                                <Ellipse Width="116"
                                         Height="116"
                                         Fill="{Binding GlowBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False" />

                                <Image Source="{Binding LogoImage}"
                                       Width="82"
                                       Height="82"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,0,22">
                <Border Width="7" Height="26" CornerRadius="3.5" Background="{StaticResource SuccessGreenBrush}" Margin="0,0,14,0" />
                <TextBlock Text="Thư viện &amp; Hệ thống"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding OfflineAndSystemTiles}" Margin="0,4,0,8" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlassTileButtonStyle}"
                                Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Title}"
                                MinWidth="196"
                                MinHeight="164"
                                Width="200"
                                Height="166"
                                Padding="0"
                                Margin="0,0,24,24">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False">
                                <Ellipse Width="116"
                                         Height="116"
                                         Fill="{Binding GlowBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False" />

                                <Image Source="{Binding LogoImage}"
                                       Width="80"
                                       Height="80"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
