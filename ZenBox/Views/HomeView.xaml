<UserControl x:Class="ZenBox.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PrimaryFontFamily}">

    <!-- Đặt khoảng đệm Margin ở BÊN TRONG ScrollViewer để hiệu ứng phóng to + nhấc nổi không bao giờ bị cắt cạnh -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="56,32,40,32" ClipToBounds="False">
            <!-- Khu vực 1: Giải trí trực tuyến -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,22">
                <Border Width="8" Height="28" CornerRadius="4" Background="{StaticResource LiquidCyanPillBrush}" Margin="0,0,14,0" />
                <TextBlock Text="Giải trí trực tuyến"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding OnlineTiles}" Margin="0,4,0,20" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlassTileButtonStyle}"
                                Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Width="340"
                                Height="234"
                                Padding="28,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Huy hiệu Icon 3D Liquid Lens có ánh kính phản chiếu -->
                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <Grid Width="66" Height="66" HorizontalAlignment="Left">
                                        <Ellipse Fill="{Binding GlowBrush}" Margin="-10" IsHitTestVisible="False" />
                                        <Border CornerRadius="20" Background="{Binding BadgeBrush}" />
                                        <Border CornerRadius="20" Background="{StaticResource LiquidTopSheenBrush}" />
                                        <Border CornerRadius="20" BorderBrush="#66FFFFFF" BorderThickness="1.2" />
                                        <Path Data="{Binding IconGeometry}"
                                              Fill="#FFFFFF"
                                              Stretch="Uniform"
                                              Width="30"
                                              Height="30"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Background="#1EFFFFFF"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <Path Data="{StaticResource IconChevronRightGeometry}"
                                              Fill="#CBD5E1"
                                              Stretch="Uniform"
                                              Width="14"
                                              Height="14"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="18"
                                               FontWeight="Regular"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="24" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Khu vực 2: Thư viện của tôi & Hệ thống -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,8,0,22">
                <Border Width="8" Height="28" CornerRadius="4" Background="{StaticResource SuccessGreenBrush}" Margin="0,0,14,0" />
                <TextBlock Text="Thư viện của tôi &amp; Hệ thống"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding OfflineAndSystemTiles}" Margin="0,4,0,8" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlassTileButtonStyle}"
                                Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Width="340"
                                Height="234"
                                Padding="28,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <Grid Width="66" Height="66" HorizontalAlignment="Left">
                                        <Ellipse Fill="{Binding GlowBrush}" Margin="-10" IsHitTestVisible="False" />
                                        <Border CornerRadius="20" Background="{Binding BadgeBrush}" />
                                        <Border CornerRadius="20" Background="{StaticResource LiquidTopSheenBrush}" />
                                        <Border CornerRadius="20" BorderBrush="#66FFFFFF" BorderThickness="1.2" />
                                        <Path Data="{Binding IconGeometry}"
                                              Fill="#FFFFFF"
                                              Stretch="Uniform"
                                              Width="30"
                                              Height="30"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Background="#1EFFFFFF"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <Path Data="{StaticResource IconChevronRightGeometry}"
                                              Fill="#CBD5E1"
                                              Stretch="Uniform"
                                              Width="14"
                                              Height="14"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="18"
                                               FontWeight="Regular"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="24" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
