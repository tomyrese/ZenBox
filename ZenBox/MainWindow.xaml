<Window x:Class="ZenBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZenBox.Views"
        xmlns:controls="clr-namespace:ZenBox.Controls"
        Title="ZenBox"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource DeepDarkBackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid Background="{StaticResource DeepDarkBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- Thanh trạng thái trên cùng cố định -->
        <Border Grid.Row="0"
                Background="#990B0F19"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="48,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo ZenBox -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="14"
                            Background="#3338BDF8"
                            BorderBrush="{StaticResource AccentCyanBrush}"
                            BorderThickness="2"
                            Margin="0,0,16,0">
                        <TextBlock Text="Z"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ZenBox"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Huy hiệu Trạng thái mạng trực quan ở giữa/phải -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="20"
                            Padding="20,10"
                            Margin="0,0,32,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessGreenSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessGreenBrush}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource WarningCoralSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningCoralBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource WarningCoralBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Text="{Binding NetworkStatusLabel}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource WarningCoralBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Đồng hồ HH:mm và Thứ/Ngày/Tháng tiếng Việt -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VietnameseDateText}"
                                   FontSize="20"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0" />
                        <TextBlock Text="{Binding ClockTimeText}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Khu vực hiển thị các màn hình chính -->
        <Grid Grid.Row="1">
            <views:HomeView DataContext="{Binding HomeVm}"
                            Visibility="{Binding DataContext.IsHomeVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- WebContainerView luôn giữ trong cây giao diện để bảo toàn trạng thái các tab YouTube/Facebook/TikTok -->
            <views:WebContainerView DataContext="{Binding WebVm}"
                                    Visibility="{Binding DataContext.IsWebSectionVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <views:MediaLibraryView DataContext="{Binding MediaLibraryVm}"
                                    Visibility="{Binding DataContext.IsMediaLibraryVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <views:MediaPlayerView DataContext="{Binding MediaPlayerVm}"
                                   Visibility="{Binding DataContext.IsMediaPlayerVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <views:SettingsView DataContext="{Binding SettingsVm}"
                                Visibility="{Binding DataContext.IsSettingsVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Thanh gợi ý thao tác nhanh ở cạnh dưới -->
        <Border Grid.Row="2"
                Background="#990B0F19"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="48,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Gợi ý nhanh: Bấm vào nút tròn xanh nổi trên màn hình để mở nhanh Trang Chủ, đổi kênh hoặc chỉnh âm lượng bất cứ lúc nào."
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="Điều khiển từ xa mạng nội bộ: cổng 8989"
                           FontSize="18"
                           Foreground="{StaticResource AccentCyanBrush}"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
            </Grid>
        </Border>

        <!-- Hộp thoại báo lỗi Glass cỡ lớn thân thiện Tiếng Việt -->
        <controls:ErrorDialogOverlay Grid.RowSpan="3"
                                     Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
