<Window x:Class="ZenBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZenBox.ViewModels"
        xmlns:views="clr-namespace:ZenBox.Views"
        xmlns:controls="clr-namespace:ZenBox.Controls"
        Title="ZenBox"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource DeepDarkBackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaLibraryViewModel}">
            <views:MediaLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaPlayerViewModel}">
            <views:MediaPlayerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource DeepDarkBackgroundBrush}" ClipToBounds="True">
        <!-- Quầng sáng Ambient Aurora tinh tế tạo chiều sâu không gian hiện đại -->
        <Ellipse Width="960"
                 Height="640"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-260,-240,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1F38BDF8" Offset="0.0" />
                    <GradientStop Color="#0038BDF8" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="1020"
                 Height="720"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-280,-260"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A6366F1" Offset="0.0" />
                    <GradientStop Color="#006366F1" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <!-- Thanh trạng thái trên cùng thẳng hàng chuẩn 56px -->
            <Border Grid.Row="0"
                    Background="#80090D16"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="0,0,0,1"
                    Padding="56,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo ZenBox Vector hiện đại -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48"
                                Height="48"
                                CornerRadius="15"
                                Background="{StaticResource BrandLogoBrush}"
                                Margin="0,0,16,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="#0284C7" />
                            </Border.Effect>
                            <Path Data="{StaticResource IconZenLogoGeometry}"
                                  Fill="#FFFFFF"
                                  Stretch="Uniform"
                                  Width="26"
                                  Height="26"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ZenBox"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Huy hiệu mạng & Đồng hồ bên phải -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="22"
                                Padding="20,9"
                                Margin="0,0,32,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SuccessGreenSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="#5534D399" />
                                    <Setter Property="BorderThickness" Value="1.2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource WarningCoralSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="#66FB7185" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource WarningCoralBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Text="{Binding NetworkStatusLabel}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningCoralBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding VietnameseDateText}"
                                   FontSize="19"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,22,0" />
                        <TextBlock Text="{Binding ClockTimeText}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Vùng hiển thị chính: Tách biệt hoàn toàn để không bao giờ bị chồng chéo -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding ActiveNonWebViewModel}"
                                Focusable="False"
                                Visibility="{Binding IsNonWebHostVisible, Converter={StaticResource BoolToVis}}" />

                <views:WebContainerView DataContext="{Binding WebVm}"
                                        Visibility="{Binding DataContext.IsWebSectionVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Thanh gợi ý thao tác nhanh dưới đáy thẳng hàng 56px -->
            <Border Grid.Row="2"
                    Background="#80090D16"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="56,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Mẹo nhanh: Bấm nút tròn nổi bên phải màn hình để mở nhanh Trang Chủ, đổi kênh hoặc chỉnh âm lượng."
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="Điều khiển qua điện thoại: cổng 8989"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource AccentCyanBrush}"
                               VerticalAlignment="Center"
                               Margin="24,0,0,0" />
                </Grid>
            </Border>

            <!-- Hộp thoại báo lỗi Glass -->
            <controls:ErrorDialogOverlay Grid.RowSpan="3"
                                         Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
