<Window x:Class="ZenBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZenBox.ViewModels"
        xmlns:views="clr-namespace:ZenBox.Views"
        xmlns:controls="clr-namespace:ZenBox.Controls"
        Title="ZenBox"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource DeepDarkBackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaLibraryViewModel}">
            <views:MediaLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaPlayerViewModel}">
            <views:MediaPlayerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource DeepDarkBackgroundBrush}" ClipToBounds="True">
        <!-- Nền Liquid Aurora sống động -->
        <Ellipse Width="1150"
                 Height="780"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-280,-260,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2638BDF8" Offset="0.0" />
                    <GradientStop Color="#0D0284C7" Offset="0.55" />
                    <GradientStop Color="#000284C7" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="1220"
                 Height="840"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-320,-280"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#246366F1" Offset="0.0" />
                    <GradientStop Color="#0CA855F7" Offset="0.55" />
                    <GradientStop Color="#00A855F7" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Thanh trạng thái trên cùng: Tự ẩn hoàn toàn khi mở ứng dụng con để ứng dụng tràn 100% màn hình như App gốc -->
            <Border Grid.Row="0"
                    Height="92"
                    Background="#48060A14"
                    BorderBrush="#1EFFFFFF"
                    BorderThickness="0,0,0,1"
                    Padding="56,0"
                    Visibility="{Binding IsSystemShellChromeVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo ZenBox tinh gọn không hộp nền rườm rà -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconZenLogoGeometry}"
                              Fill="{StaticResource BrandLogoBrush}"
                              Stretch="Uniform"
                              Width="38"
                              Height="38"
                              Margin="0,0,14,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="ZenBox"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Viên thuốc Liquid Glass báo trạng thái mạng & thời gian -->
                    <Border Grid.Column="2"
                            Background="#18FFFFFF"
                            BorderBrush="{StaticResource LiquidGlassRimBrush}"
                            BorderThickness="1.2"
                            CornerRadius="26"
                            Padding="22,8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="16"
                                    Padding="14,6"
                                    Margin="0,0,22,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessGreenSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="#5534D399" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource WarningCoralSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="#66FB7185" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource WarningCoralBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding NetworkStatusLabel}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetworkConnected}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningCoralBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding VietnameseDateText}"
                                       FontSize="19"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,0" />

                            <TextBlock Text="{Binding ClockTimeText}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Vùng hiển thị chính (Tràn viền 100% màn hình khi chạy App) -->
            <Grid Grid.Row="1" ClipToBounds="False">
                <ContentControl Content="{Binding ActiveNonWebViewModel}"
                                Focusable="False"
                                ClipToBounds="False"
                                Visibility="{Binding IsNonWebHostVisible, Converter={StaticResource BoolToVis}}" />

                <views:WebContainerView DataContext="{Binding WebVm}"
                                        Visibility="{Binding DataContext.IsWebSectionVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Thanh gợi ý dưới cùng: Cũng tự ẩn khi đang ở trong App -->
            <Border Grid.Row="2"
                    Height="50"
                    Background="#48060A14"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="56,0"
                    Visibility="{Binding IsSystemShellChromeVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Mẹo nhanh: Bấm viên ngọc nổi bên phải màn hình để đổi ứng dụng, về Trang Chủ hoặc chỉnh âm lượng."
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="Điều khiển qua điện thoại: cổng 8989"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource AccentCyanBrush}"
                               VerticalAlignment="Center"
                               Margin="24,0,0,0" />
                </Grid>
            </Border>

            <!-- Hộp thoại thông báo Liquid Glass -->
            <controls:ErrorDialogOverlay Grid.RowSpan="3"
                                         Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
