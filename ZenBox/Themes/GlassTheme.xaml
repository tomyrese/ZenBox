<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bảng màu chuẩn Apple visionOS / tvOS Liquid Glass -->
    <Color x:Key="BgStartColor">#060913</Color>
    <Color x:Key="BgMidColor">#0B1120</Color>
    <Color x:Key="BgEndColor">#0F172A</Color>
    <Color x:Key="AccentCyanColor">#38BDF8</Color>
    <Color x:Key="SuccessGreenColor">#34D399</Color>
    <Color x:Key="WarningCoralColor">#FB7185</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>

    <LinearGradientBrush x:Key="DeepDarkBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BgStartColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource BgMidColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource BgEndColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Vật liệu Liquid Glass đa tầng khúc xạ ánh sáng -->
    <LinearGradientBrush x:Key="LiquidGlassFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#28FFFFFF" Offset="0.0" />
        <GradientStop Color="#12FFFFFF" Offset="0.48" />
        <GradientStop Color="#1838BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidGlassHoverFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DFFFFFF" Offset="0.0" />
        <GradientStop Color="#1EFFFFFF" Offset="0.45" />
        <GradientStop Color="#3038BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Viền khúc xạ Specular Rim đặc trưng của Liquid Glass -->
    <LinearGradientBrush x:Key="LiquidGlassRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6EFFFFFF" Offset="0.0" />
        <GradientStop Color="#1CFFFFFF" Offset="0.38" />
        <GradientStop Color="#14FFFFFF" Offset="0.72" />
        <GradientStop Color="#4D38BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidGlassActiveRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EEFFFFFF" Offset="0.0" />
        <GradientStop Color="#CC38BDF8" Offset="0.5" />
        <GradientStop Color="#DD818CF8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Ánh phản chiếu vòm kính phía trên (Specular Top Sheen) -->
    <LinearGradientBrush x:Key="LiquidTopSheenBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#2CFFFFFF" Offset="0.0" />
        <GradientStop Color="#06FFFFFF" Offset="0.45" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidDialogFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EE152036" Offset="0.0" />
        <GradientStop Color="#F20D1526" Offset="0.55" />
        <GradientStop Color="#F2111C33" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidCyanPillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0.0" />
        <GradientStop Color="#0284C7" Offset="0.55" />
        <GradientStop Color="#2563EB" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidCyanPillHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7DD3FC" Offset="0.0" />
        <GradientStop Color="#0EA5E9" Offset="0.55" />
        <GradientStop Color="#3B82F6" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidCoralPillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DFB7185" Offset="0.0" />
        <GradientStop Color="#28E11D48" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandLogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Bóng đổ mềm GPU bằng RadialGradient (không gây giật lag khi Scale 60-120fps) -->
    <RadialGradientBrush x:Key="SoftContactShadowBrush">
        <GradientStop Color="#58000000" Offset="0.0" />
        <GradientStop Color="#28000000" Offset="0.55" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="CyanAmbientBloomBrush">
        <GradientStop Color="#4038BDF8" Offset="0.0" />
        <GradientStop Color="#1638BDF8" Offset="0.5" />
        <GradientStop Color="#0038BDF8" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="CoralAmbientBloomBrush">
        <GradientStop Color="#3CFB7185" Offset="0.0" />
        <GradientStop Color="#14FB7185" Offset="0.5" />
        <GradientStop Color="#00FB7185" Offset="1.0" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#CC03060D" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentCyanSoftBrush" Color="#2438BDF8" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
    <SolidColorBrush x:Key="SuccessGreenSoftBrush" Color="#2034D399" />
    <SolidColorBrush x:Key="WarningCoralBrush" Color="{StaticResource WarningCoralColor}" />
    <SolidColorBrush x:Key="WarningCoralSoftBrush" Color="#24FB7185" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <FontFamily x:Key="PrimaryFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

