    <!-- Khung thẻ Liquid Glass tĩnh -->
    <Style x:Key="GlassPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LiquidGlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassRimBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="28" />
    </Style>

    <!-- Thẻ ứng dụng / Poster Liquid Glass: Chuyển động lơ lửng mượt 120fps, KHÔNG nhảy viền, KHÔNG bị cắt -->
    <Style x:Key="GlassTileButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="MinHeight" Value="190" />
        <Setter Property="Margin" Value="0,0,28,28" />
        <Setter Property="Padding" Value="26" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid ClipToBounds="False">
                        <!-- Tầng 0: Bóng mềm & Quầng sáng lơ lửng phía dưới -->
                        <Ellipse Margin="16,24,16,-14"
                                 Fill="{StaticResource SoftContactShadowBrush}"
                                 IsHitTestVisible="False" />
                        <Ellipse x:Name="HoverAura"
                                 Margin="-12,-12,-12,-16"
                                 Fill="{StaticResource CyanAmbientBloomBrush}"
                                 Opacity="0"
                                 IsHitTestVisible="False" />

                        <!-- Tầng 1: Thân kính mờ khúc xạ -->
                        <Border Background="{StaticResource LiquidGlassFillBrush}"
                                BorderBrush="{StaticResource LiquidGlassRimBrush}"
                                BorderThickness="1.5"
                                CornerRadius="28" />

                        <!-- Tầng 2: Lớp sáng Hover mượt mà -->
                        <Border x:Name="HoverGlassFill"
                                Background="{StaticResource LiquidGlassHoverFillBrush}"
                                CornerRadius="28"
                                Opacity="0"
                                IsHitTestVisible="False" />

                        <!-- Tầng 3: Vòm phản chiếu ánh sáng trên đỉnh kính (Liquid Specular Lens) -->
                        <Border Background="{StaticResource LiquidTopSheenBrush}"
                                CornerRadius="28"
                                Margin="1.5"
                                IsHitTestVisible="False" />

                        <!-- Tầng 4: Nội dung chính -->
                        <Border Padding="{TemplateBinding Padding}" CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <!-- Tầng 5: Viền phát sáng độc lập (không làm dịch chuyển nội dung bên trong) -->
                        <Border x:Name="GlowRim"
                                BorderBrush="{StaticResource LiquidGlassActiveRimBrush}"
                                BorderThickness="2.5"
                                CornerRadius="28"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.045" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.045" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-6" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlassFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="GlowRim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="HoverAura"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85" Duration="0:0:0.30" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlassFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="GlowRim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="HoverAura"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="0.985" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="0.985" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.045" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.045" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-6" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="GlowRim" Property="Opacity" Value="1.0" />
                            <Setter TargetName="HoverGlassFill" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút viên thuốc Liquid Glass Capsule (mượt mà, không nhảy pixel khi hover) -->
    <Style x:Key="GlassActionButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource LiquidGlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassRimBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid ClipToBounds="False">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.4"
                                CornerRadius="24" />
                        <Border x:Name="BtnHoverLayer"
                                Background="{StaticResource LiquidGlassHoverFillBrush}"
                                CornerRadius="24"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border Background="{StaticResource LiquidTopSheenBrush}"
                                CornerRadius="24"
                                Margin="1.4"
                                IsHitTestVisible="False" />
                        <Border Padding="{TemplateBinding Padding}" CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="BtnGlowRim"
                                BorderBrush="{StaticResource LiquidGlassActiveRimBrush}"
                                BorderThickness="2.2"
                                CornerRadius="24"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.04" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.04" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-2" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnHoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="BtnGlowRim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.20" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnHoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="BtnGlowRim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="0.975" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="0.975" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.04" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.04" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút chính Liquid Cyan Pill rực rỡ -->
    <Style x:Key="PrimaryCyanButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource LiquidCyanPillBrush}" />
        <Setter Property="BorderBrush" Value="#99FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Nút cảnh báo / Thoát Liquid Rose Glass -->
    <Style x:Key="CoralWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource LiquidCoralPillBrush}" />
        <Setter Property="BorderBrush" Value="#88FB7185" />
        <Setter Property="Foreground" Value="#FFE4E6" />
    </Style>

    <!-- Thanh tiến trình Media Liquid Glass -->
    <Style x:Key="ModernMediaSliderStyle" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="10"
                                CornerRadius="5"
                                Background="#28FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="10"
                                                    CornerRadius="5"
                                                    Background="{StaticResource LiquidCyanPillHoverBrush}"
                                                    VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="10" Background="Transparent" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="28" Height="28">
                                                <Ellipse Fill="#5538BDF8" Margin="-4" />
                                                <Ellipse Fill="#FFFFFF"
                                                         Stroke="{StaticResource AccentCyanBrush}"
                                                         StrokeThickness="3" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Công tắc Liquid Glass cỡ lớn -->
    <Style x:Key="LargeSwitchCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SwitchTrack"
                                Width="92"
                                Height="50"
                                CornerRadius="25"
                                Background="#24FFFFFF"
                                BorderBrush="{StaticResource LiquidGlassRimBrush}"
                                BorderThickness="1.5"
                                Padding="6">
                            <Ellipse x:Name="SwitchThumb"
                                     Width="36"
                                     Height="36"
                                     Fill="#F8FAFC"
                                     HorizontalAlignment="Left" />
                        </Border>
                        <ContentPresenter Margin="20,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource LiquidCyanPillBrush}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#99FFFFFF" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
