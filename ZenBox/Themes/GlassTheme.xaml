    <!-- Khung thẻ Crystal Liquid Glass tĩnh -->
    <Style x:Key="GlassPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LiquidGlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassRimBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="CornerRadius" Value="26" />
    </Style>

    <!-- Thẻ ứng dụng / Poster Crystal Liquid Glass trong trẻo, chuyển động 120fps -->
    <Style x:Key="GlassTileButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MinHeight" Value="162" />
        <Setter Property="Margin" Value="0,0,24,24" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid ClipToBounds="False">
                        <Ellipse Margin="16,24,16,-14"
                                 Fill="{StaticResource SoftContactShadowBrush}"
                                 IsHitTestVisible="False" />
                        <Ellipse x:Name="HoverAura"
                                 Margin="-12,-12,-12,-16"
                                 Fill="{StaticResource CyanAmbientBloomBrush}"
                                 Opacity="0"
                                 IsHitTestVisible="False" />

                        <Border Background="{StaticResource LiquidGlassFillBrush}"
                                BorderBrush="{StaticResource LiquidGlassRimBrush}"
                                BorderThickness="1.2"
                                CornerRadius="28" />

                        <Border x:Name="HoverGlassFill"
                                Background="{StaticResource LiquidGlassHoverFillBrush}"
                                CornerRadius="28"
                                Opacity="0"
                                IsHitTestVisible="False" />

                        <!-- Chỉ sáng Specular mảnh 1px dọc cạnh đỉnh mặt kính -->
                        <Border Height="1.2"
                                VerticalAlignment="Top"
                                Margin="24,1,24,0"
                                Background="{StaticResource LiquidTopHairlineBrush}"
                                IsHitTestVisible="False" />

                        <Border Padding="{TemplateBinding Padding}" CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <Border x:Name="GlowRim"
                                BorderBrush="{StaticResource LiquidGlassActiveRimBrush}"
                                BorderThickness="2.4"
                                CornerRadius="28"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.055" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.055" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-6" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlassFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="GlowRim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="HoverAura"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.9" Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlassFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="GlowRim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="HoverAura"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="0.975" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="0.975" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.055" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.055" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-6" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="GlowRim" Property="Opacity" Value="1.0" />
                            <Setter TargetName="HoverGlassFill" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút viên thuốc Crystal Liquid Capsule -->
    <Style x:Key="GlassActionButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource LiquidGlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassRimBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid ClipToBounds="False">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.2"
                                CornerRadius="24" />
                        <Border x:Name="BtnHoverLayer"
                                Background="{StaticResource LiquidGlassHoverFillBrush}"
                                CornerRadius="24"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border Height="1"
                                VerticalAlignment="Top"
                                Margin="20,1,20,0"
                                Background="{StaticResource LiquidTopHairlineBrush}"
                                IsHitTestVisible="False" />
                        <Border Padding="{TemplateBinding Padding}" CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="BtnGlowRim"
                                BorderBrush="{StaticResource LiquidGlassActiveRimBrush}"
                                BorderThickness="2"
                                CornerRadius="24"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.04" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.04" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-2" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnHoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="BtnGlowRim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnHoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="BtnGlowRim"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.04" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.04" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryCyanButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource LiquidCyanPillBrush}" />
        <Setter Property="BorderBrush" Value="#88FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style x:Key="CoralWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource LiquidCoralPillBrush}" />
        <Setter Property="BorderBrush" Value="#88FB7185" />
        <Setter Property="Foreground" Value="#FFE4E6" />
    </Style>

    <!-- Thanh trượt Âm lượng / Tiến trình Media mượt mà -->
    <Style x:Key="ModernMediaSliderStyle" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="10"
                                CornerRadius="5"
                                Background="#26FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="10"
                                                    CornerRadius="5"
                                                    Background="{StaticResource LiquidCyanPillHoverBrush}"
                                                    VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="10" Background="Transparent" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="26" Height="26">
                                                <Ellipse Fill="#5538BDF8" Margin="-4" />
                                                <Ellipse Fill="#FFFFFF"
                                                         Stroke="{StaticResource AccentCyanBrush}"
                                                         StrokeThickness="3" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LargeSwitchCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SwitchTrack"
                                Width="88"
                                Height="48"
                                CornerRadius="24"
                                Background="#22FFFFFF"
                                BorderBrush="{StaticResource LiquidGlassRimBrush}"
                                BorderThickness="1.4"
                                Padding="5">
                            <Ellipse x:Name="SwitchThumb"
                                     Width="35"
                                     Height="35"
                                     Fill="#F8FAFC"
                                     HorizontalAlignment="Left" />
                        </Border>
                        <ContentPresenter Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource LiquidCyanPillBrush}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#88FFFFFF" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
