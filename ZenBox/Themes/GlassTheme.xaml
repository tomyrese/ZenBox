<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bảng màu hiện đại chuẩn Apple TV / Google TV 10-Foot Glassmorphism -->
    <Color x:Key="BgStartColor">#0B0F19</Color>
    <Color x:Key="BgMidColor">#0E1526</Color>
    <Color x:Key="BgEndColor">#111827</Color>
    <Color x:Key="AccentCyanColor">#38BDF8</Color>
    <Color x:Key="AccentBlueColor">#0284C7</Color>
    <Color x:Key="SuccessGreenColor">#34D399</Color>
    <Color x:Key="WarningCoralColor">#FB7185</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>

    <LinearGradientBrush x:Key="DeepDarkBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BgStartColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource BgMidColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource BgEndColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Hiệu ứng kính mờ đa tầng sang trọng -->
    <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FFFFFFF" Offset="0.0" />
        <GradientStop Color="#12FFFFFF" Offset="0.55" />
        <GradientStop Color="#0AFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#30FFFFFF" Offset="0.0" />
        <GradientStop Color="#1C38BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DFFFFFF" Offset="0.0" />
        <GradientStop Color="#1AFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryCyanGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5E9" Offset="0.0" />
        <GradientStop Color="#0284C7" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryCyanHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0.0" />
        <GradientStop Color="#0EA5E9" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandLogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassPanelStrongBrush" Color="#F20F172A" />
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#D9050811" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentCyanSoftBrush" Color="#2438BDF8" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
    <SolidColorBrush x:Key="SuccessGreenSoftBrush" Color="#1F34D399" />
    <SolidColorBrush x:Key="WarningCoralBrush" Color="{StaticResource WarningCoralColor}" />
    <SolidColorBrush x:Key="WarningCoralSoftBrush" Color="#24FB7185" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <FontFamily x:Key="PrimaryFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

